ARG PHP_VERSION=8.3
FROM php:${PHP_VERSION}-fpm

ARG UID=1000
ARG GID=1000

# OPcache nao aparece na lista de docker-php-ext-install abaixo de proposito.
# Ele ja vem carregado nas imagens oficiais 8.3, 8.4 e 8.5 - conferido com
# php -r 'var_dump(extension_loaded("Zend OPcache"));' nas tres. Instalar de
# novo era redundante e, a partir do 8.5, quebra o build: naquela versao o
# OPcache passou a ser compilado estaticamente, o phpize nao gera .so e o
# docker-php-ext-install falha em "cp: cannot stat 'modules/*'".
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libwebp-dev \
    libfreetype6-dev \
    libzip-dev \
    libicu-dev \
    libonig-dev \
    libxml2-dev \
    libpq-dev \
    unzip \
    git \
    curl \
    zip \
    nano \
    default-mysql-client \
    postgresql-client \
    msmtp \
    msmtp-mta \
    gnupg \
    ca-certificates \
    lsb-release \
    openssl \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install \
        mysqli \
        pdo \
        pdo_mysql \
        pdo_pgsql \
        pgsql \
        gd \
        intl \
        mbstring \
        zip \
        exif \
        bcmath \
        soap \
        sockets \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN pecl install xdebug \
    && docker-php-ext-enable xdebug

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY php/php.ini /usr/local/etc/php/php.ini

# Habilita a funcao mail() do PHP. O php.ini ja aponta sendmail_path para
# /usr/sbin/sendmail; o pacote msmtp-mta e quem cria esse binario. Sem ele,
# mail() retorna false com "sendmail: not found", falhando em silencio.
COPY php/msmtprc /etc/msmtprc
RUN chmod 644 /etc/msmtprc \
    && touch /var/log/msmtp.log \
    && chmod 666 /var/log/msmtp.log \
    && test -x /usr/sbin/sendmail

RUN touch /var/log/php_errors.log \
    && chmod 666 /var/log/php_errors.log \
    && usermod -u ${UID} www-data \
    && groupmod -g ${GID} www-data \
    && chown -R www-data:www-data /var/www \
    && chown -R www-data:www-data /var/log/php_errors.log

WORKDIR /var/www/html

CMD ["php-fpm"]
