# Configuracao do msmtp, que fornece o binario /usr/sbin/sendmail.
#
# Com ele instalado, a funcao mail() do PHP passa a funcionar: o php.ini ja
# aponta sendmail_path para /usr/sbin/sendmail, que antes nao existia na imagem.
#
# O msmtp nao entrega diretamente ao destino; ele repassa a um servidor. Aqui o
# repasse vai para o Mailpit, entao mail() funciona e a mensagem fica retida na
# caixa local, sem risco de disparo real durante testes.
#
# Este arquivo e montado como volume: editar e reiniciar o container ja aplica,
# sem reconstruir a imagem.
#
#   docker compose --profile php84 restart php-fpm-84
#
# Para enviar de verdade pelo PHP nativo, comente o bloco "default" abaixo e
# descomente o exemplo do Gmail no fim do arquivo.
#
# ATENCAO: a senha fica em texto puro neste arquivo. Se a intencao for envio
# real, prefira o modo SMTP na tela de configuracao da aplicacao, onde ela e
# cifrada no banco.

defaults
auth            off
tls             off
logfile         /var/log/msmtp.log

# Destino atual: caixa local. As mensagens NAO saem da maquina.
account         default
host            mailpit
port            1025
from            nao-responda@db-sync-ide.local

# Envio real pelo Gmail. Para usar, comente o bloco acima e descomente este,
# trocando o endereco e a senha de aplicativo de 16 caracteres.
#
# account        default
# host           smtp.gmail.com
# port           587
# auth           on
# tls            on
# tls_starttls   on
# tls_trust_file /etc/ssl/certs/ca-certificates.crt
# user           seu-endereco@gmail.com
# password       sua-senha-de-aplicativo
# from           seu-endereco@gmail.com
